---
// 背景漂浮微粒：纯 CSS 动画，无 JS；亮色为白色微尘，暗色为蓝色萤火。
const particles = [
	{ x: 8, y: 22, s: 5, fd: 17, td: 6, dx: 14, dy: -22 },
	{ x: 16, y: 64, s: 4, fd: 21, td: 5, dx: -12, dy: -30 },
	{ x: 22, y: 12, s: 6, fd: 15, td: 7, dx: 18, dy: -14 },
	{ x: 30, y: 82, s: 3, fd: 24, td: 4, dx: -20, dy: -24 },
	{ x: 37, y: 40, s: 5, fd: 19, td: 8, dx: 10, dy: -26 },
	{ x: 44, y: 18, s: 4, fd: 23, td: 6, dx: -14, dy: -18 },
	{ x: 50, y: 70, s: 6, fd: 16, td: 5, dx: 16, dy: -32 },
	{ x: 57, y: 33, s: 3, fd: 26, td: 7, dx: -18, dy: -12 },
	{ x: 63, y: 55, s: 5, fd: 18, td: 4, dx: 12, dy: -28 },
	{ x: 69, y: 10, s: 4, fd: 22, td: 6, dx: -10, dy: -20 },
	{ x: 74, y: 78, s: 6, fd: 20, td: 8, dx: 20, dy: -16 },
	{ x: 80, y: 42, s: 3, fd: 25, td: 5, dx: -16, dy: -30 },
	{ x: 86, y: 68, s: 5, fd: 17, td: 7, dx: 14, dy: -22 },
	{ x: 91, y: 25, s: 4, fd: 21, td: 6, dx: -12, dy: -24 },
	{ x: 96, y: 50, s: 5, fd: 19, td: 5, dx: 10, dy: -18 },
	{ x: 12, y: 90, s: 4, fd: 23, td: 8, dx: 18, dy: -26 },
	{ x: 48, y: 6, s: 3, fd: 27, td: 4, dx: -14, dy: -16 },
	{ x: 77, y: 90, s: 5, fd: 18, td: 6, dx: 16, dy: -20 },
];
---
<div id="bg-particles" aria-hidden="true">
	{particles.map(p => (
		<span
			style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;
				--float-dur:${p.fd}s;--float-delay:${-(p.fd / 2).toFixed(1)}s;
				--twinkle-dur:${p.td}s;--twinkle-delay:${(p.td / 3).toFixed(1)}s;
				--dx:${p.dx}px;--dy:${p.dy}px;`}
		></span>
	))}
</div>
