---
// 写作后台：论坛式编辑器，浏览器直接提交到 GitHub，Actions 自动构建
import siteData from '@/data/site.json'
const initialSignature = siteData.signature ?? ''
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>写文章 · 宁安</title>
  <link rel="icon" type="image/png" href="/icons/favicon.png" />
  <style>
    :root {
      --bg: #f5f4f2;
      --card: #ffffff;
      --ink: #222124;
      --muted: #77767a;
      --line: #e4e2df;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
      font-size: 15px;
      line-height: 1.7;
    }
    a { color: inherit; }
    .wrap { max-width: 900px; margin: 0 auto; padding: 28px 20px 80px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
    .brand { font-family: "Noto Serif SC", "Songti SC", serif; font-size: 22px; font-weight: 600; letter-spacing: .04em; }
    .topbar nav { display: flex; gap: 16px; font-size: 14px; color: var(--muted); }
    .topbar nav a:hover { color: var(--ink); }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 22px; margin-bottom: 18px; }
    .card h2 { margin: 0 0 14px; font-size: 15px; font-weight: 600; }
    .row { display: flex; gap: 12px; flex-wrap: wrap; }
    .row > * { flex: 1 1 200px; }
    label.field { display: block; margin-bottom: 14px; }
    label.field span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; letter-spacing: .05em; }
    input[type="text"], input[type="password"], textarea {
      width: 100%; border: 1px solid var(--line); border-radius: 6px; background: #fff;
      padding: 10px 12px; font: inherit; color: var(--ink); outline: none;
    }
    input:focus, textarea:focus { border-color: #b9b7b2; }
    input.title-input { font-family: "Noto Serif SC", "Songti SC", serif; font-size: 24px; padding: 12px 14px; }
    .btn { border: 0; border-radius: 6px; padding: 10px 20px; font: inherit; cursor: pointer; background: #222124; color: #fff; }
    .btn:hover { opacity: .85; }
    .btn:disabled { opacity: .45; cursor: default; }
    .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
    .btn.small { padding: 6px 12px; font-size: 13px; }
    .actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
    .status { font-size: 13px; color: var(--muted); min-height: 20px; flex: 1 1 260px; }
    .status.ok { color: #2f7a4d; }
    .status.err { color: #b23b3b; }
    .composer { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
    .toolbar {
      display: flex; flex-wrap: wrap; gap: 2px; padding: 6px 8px;
      border-bottom: 1px solid var(--line); background: #faf9f7;
    }
    .toolbar button {
      border: 0; background: transparent; color: #4a494d; cursor: pointer;
      padding: 6px 9px; border-radius: 4px; font: inherit; line-height: 1;
    }
    .toolbar button:hover { background: #efedea; }
    .toolbar .sep { width: 1px; background: var(--line); margin: 4px 6px; }
    .pane { min-height: 360px; }
    .pane textarea {
      border: 0; border-radius: 0; min-height: 360px; resize: vertical;
      font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 14px; line-height: 1.8; padding: 16px 18px;
    }
    .pane textarea:focus { border: 0; }
    .preview { padding: 18px 22px; min-height: 360px; display: none; }
    .preview.on { display: block; }
    .preview h1, .preview h2, .preview h3 { font-family: "Noto Serif SC", "Songti SC", serif; line-height: 1.45; margin: 1.2em 0 .6em; }
    .preview h2 { font-size: 22px; }
    .preview h3 { font-size: 18px; }
    .preview p { margin: .8em 0; }
    .preview blockquote { margin: 1em 0; padding: .2em 1em; border-left: 3px solid #d8d6d2; color: #55545a; }
    .preview code { background: #f1efec; padding: .15em .35em; border-radius: 4px; font-size: .92em; }
    .preview pre { background: #222124; color: #f5f4f2; padding: 14px 16px; border-radius: 6px; overflow: auto; }
    .preview pre code { background: transparent; padding: 0; }
    .preview img { max-width: 100%; border-radius: 6px; }
    .preview table { border-collapse: collapse; width: 100%; }
    .preview th, .preview td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }
    .preview a { color: #2b4b8f; }
    .tabs { display: flex; gap: 14px; font-size: 13px; color: var(--muted); padding: 8px 14px; border-top: 1px solid var(--line); background: #faf9f7; }
    .tabs button { border: 0; background: none; font: inherit; color: var(--muted); cursor: pointer; padding: 2px 0; }
    .tabs button.on { color: var(--ink); border-bottom: 2px solid var(--ink); }
    .hint { font-size: 12px; color: var(--muted); margin-top: 6px; }
    .foot { text-align: center; font-size: 12px; color: var(--muted); margin-top: 30px; }
    details { margin-top: 6px; }
    summary { cursor: pointer; font-size: 13px; color: var(--muted); }
    details[open] summary { margin-bottom: 12px; }
    @media (max-width: 640px) {
      .wrap { padding: 18px 12px 60px; }
      .card { padding: 16px; }
      .toolbar button { padding: 6px 7px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <div class="brand">宁安</div>
      <nav>
        <a href="/">文章</a>
        <a href="/tags/">标签</a>
        <a href="/about/">关于</a>
        <a href="https://github.com/zhangningan937-gif/zhangningan937-gif.github.io/actions" target="_blank" rel="noopener">构建记录</a>
      </nav>
    </div>

    <div id="edit-banner" class="card" style="display:none;border-color:#e6d9a8;background:#fbf7e6">
      <div class="actions" style="margin-top:0">
        <div class="status" id="edit-status" style="color:#6b5a12"></div>
        <div style="display:flex;gap:8px">
          <button class="btn small ghost" id="delete-post" type="button" style="color:#b23b3b;border-color:#e3c9c9">删除这篇</button>
          <a class="btn small ghost" id="view-post" href="/" target="_blank" rel="noopener" style="text-decoration:none">查看</a>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>GitHub 令牌</h2>
      <label class="field">
        <span>只保存在这台浏览器的 localStorage，不会上传到任何服务器</span>
        <input type="password" id="token" placeholder="ghp_..." autocomplete="off" />
      </label>
      <div class="actions">
        <div class="status" id="token-status">需要拥有 repo 权限的经典令牌</div>
        <div style="display:flex;gap:8px">
          <button class="btn small ghost" id="clear-token" type="button">清除</button>
          <button class="btn small" id="save-token" type="button">保存令牌</button>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>个签</h2>
      <label class="field">
        <span>显示在站名下面的一行字，留空则不显示</span>
        <input type="text" id="signature" maxlength="60" value={initialSignature} placeholder="比如：在学通信，偶尔折腾。" />
      </label>
      <div class="actions">
        <div class="status" id="signature-status"></div>
        <button class="btn small" id="save-signature" type="button">保存个签</button>
      </div>
    </div>

    <div class="card">
      <h2>写文章</h2>
      <label class="field">
        <span>标题</span>
        <input type="text" class="title-input" id="post-title" placeholder="起个标题" />
      </label>
      <div class="row">
        <label class="field">
          <span>网址（文件名，可留空自动生成）</span>
          <input type="text" id="post-slug" placeholder="比如 my-first-post" />
        </label>
        <label class="field">
          <span>标签（逗号分隔，可选）</span>
          <input type="text" id="post-tags" placeholder="学习, 随笔" />
        </label>
        <label class="field">
          <span>摘要（可选）</span>
          <input type="text" id="post-desc" placeholder="一句话说明" />
        </label>
      </div>

      <div class="composer">
        <div class="toolbar" id="toolbar">
          <button type="button" data-md="h2" title="二级标题">H</button>
          <button type="button" data-md="h3" title="三级标题">H₃</button>
          <span class="sep"></span>
          <button type="button" data-md="bold" title="粗体"><b>B</b></button>
          <button type="button" data-md="italic" title="斜体"><i>I</i></button>
          <button type="button" data-md="strike" title="删除线"><s>S</s></button>
          <span class="sep"></span>
          <button type="button" data-md="quote" title="引用">”</button>
          <button type="button" data-md="ul" title="无序列表">• 列表</button>
          <button type="button" data-md="ol" title="有序列表">1. 列表</button>
          <span class="sep"></span>
          <button type="button" data-md="code" title="行内代码">&lt;/&gt;</button>
          <button type="button" data-md="codeblock" title="代码块">代码块</button>
          <button type="button" data-md="link" title="链接">链接</button>
          <button type="button" data-md="image" title="上传图片">图片</button>
        </div>
        <div class="pane">
          <textarea id="body" placeholder="正文。支持 Markdown；图片可以直接拖进来或粘贴。"></textarea>
          <div class="preview" id="preview"></div>
        </div>
        <div class="tabs">
          <button type="button" id="tab-edit" class="on">编辑</button>
          <button type="button" id="tab-preview">预览</button>
          <span style="margin-left:auto" id="wordcount"></span>
        </div>
      </div>

      <div class="actions">
        <div class="status" id="post-status">发布后 1–2 分钟线上生效</div>
        <div style="display:flex;gap:8px">
          <button class="btn small ghost" id="save-draft" type="button">存草稿</button>
          <button class="btn" id="publish" type="button">发布</button>
        </div>
      </div>
    </div>

    <div class="foot">GitHub Actions 自动构建 · 不需要在电脑上跑任何命令</div>
  </div>

  <script is:inline src="/vendor/marked/marked.umd.js"></script>
  <script is:inline>
    const OWNER = 'zhangningan937-gif'
    const REPO = 'zhangningan937-gif.github.io'
    const BRANCH = 'source'
    const TOKEN_KEY = 'gh_token'

    const $ = id => document.getElementById(id)
    const setStatus = (el, text, kind) => { el.textContent = text; el.className = 'status' + (kind ? ' ' + kind : '') }
    const tokenInput = $('token')
    tokenInput.value = localStorage.getItem(TOKEN_KEY) || ''
    const token = () => (localStorage.getItem(TOKEN_KEY) || '').trim()

    async function gh(path, options = {}) {
      const t = token()
      if (!t) throw new Error('还没保存 GitHub 令牌')
      const res = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}${path}`, {
        ...options,
        headers: {
          'Authorization': 'Bearer ' + t,
          'Accept': 'application/vnd.github+json',
          'Content-Type': 'application/json',
          ...(options.headers || {}),
        },
      })
      if (!res.ok) {
        const body = await res.json().catch(() => ({}))
        throw new Error(`${res.status} ${body.message || res.statusText}`)
      }
      return res.status === 204 ? null : res.json()
    }

    function b64(str) {
      const bytes = new TextEncoder().encode(str)
      let binary = ''
      const chunk = 0x8000
      for (let i = 0; i < bytes.length; i += chunk) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk))
      }
      return btoa(binary)
    }

    async function getFile(path) {
      try {
        const data = await gh(`/contents/${path}?ref=${BRANCH}`)
        const binary = data.content ? atob(data.content.replace(/\n/g, '')) : ''
        const bytes = Uint8Array.from(binary, c => c.charCodeAt(0))
        return { sha: data.sha, text: new TextDecoder().decode(bytes) }
      } catch (e) {
        if (String(e.message).startsWith('404')) return null
        throw e
      }
    }

    async function putFile(path, content, message, sha) {
      return gh(`/contents/${path}`, {
        method: 'PUT',
        body: JSON.stringify({ message, content: b64(content), branch: BRANCH, ...(sha ? { sha } : {}) }),
      })
    }

    $('save-token').addEventListener('click', () => {
      const value = tokenInput.value.trim()
      if (!value) { setStatus($('token-status'), '令牌不能为空', 'err'); return }
      localStorage.setItem(TOKEN_KEY, value)
      setStatus($('token-status'), '已保存（仅本机）', 'ok')
    })
    $('clear-token').addEventListener('click', () => {
      localStorage.removeItem(TOKEN_KEY)
      tokenInput.value = ''
      setStatus($('token-status'), '已清除', 'ok')
    })

    $('save-signature').addEventListener('click', async () => {
      const btn = $('save-signature')
      btn.disabled = true
      setStatus($('signature-status'), '提交中…')
      try {
        const text = $('signature').value.trim()
        const path = 'src/data/site.json'
        const existing = await getFile(path)
        await putFile(path, JSON.stringify({ signature: text }, null, 2) + '\n', '更新个签', existing?.sha)
        setStatus($('signature-status'), '已提交，1–2 分钟后生效', 'ok')
      } catch (e) {
        setStatus($('signature-status'), e.message, 'err')
      } finally {
        btn.disabled = false
      }
    })

    // ===== 编辑器 =====
    const body = $('body')
    const preview = $('preview')

    function wrap(before, after, placeholder) {
      const start = body.selectionStart
      const end = body.selectionEnd
      const selected = body.value.slice(start, end) || placeholder || ''
      body.setRangeText(before + selected + (after || ''), start, end, 'end')
      body.focus()
      updateCount()
    }

    function prefixLines(prefix) {
      const start = body.selectionStart
      const end = body.selectionEnd
      const lineStart = body.value.lastIndexOf('\n', start - 1) + 1
      const chunk = body.value.slice(lineStart, end)
      const replaced = chunk.split('\n').map(line => line.startsWith(prefix) ? line : prefix + line).join('\n')
      body.setRangeText(replaced, lineStart, end, 'select')
      body.focus()
      updateCount()
    }

    const actions = {
      h2: () => prefixLines('## '),
      h3: () => prefixLines('### '),
      bold: () => wrap('**', '**', '粗体'),
      italic: () => wrap('*', '*', '斜体'),
      strike: () => wrap('~~', '~~', '删除线'),
      quote: () => prefixLines('> '),
      ul: () => prefixLines('- '),
      ol: () => prefixLines('1. '),
      code: () => wrap('`', '`', '代码'),
      codeblock: () => wrap('\n```\n', '\n```\n', '代码块'),
      link: () => wrap('[', '](https://)', '链接文字'),
      image: () => fileInput.click(),
    }

    $('toolbar').addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-md]')
      if (!btn) return
      const fn = actions[btn.dataset.md]
      if (fn) fn()
    })

    // 图片上传
    const fileInput = document.createElement('input')
    fileInput.type = 'file'
    fileInput.accept = 'image/*'
    fileInput.style.display = 'none'
    document.body.appendChild(fileInput)
    fileInput.addEventListener('change', () => {
      const file = fileInput.files && fileInput.files[0]
      if (file) uploadImage(file)
      fileInput.value = ''
    })

    async function uploadImage(file) {
      setStatus($('post-status'), '上传图片中…')
      try {
        if (!token()) throw new Error('请先保存 GitHub 令牌')
        const ext = (file.type.split('/')[1] || 'png').replace('jpeg', 'jpg')
        const name = `uploads/${Date.now()}.${ext}`
        const base64 = await new Promise((resolve, reject) => {
          const reader = new FileReader()
          reader.onload = () => resolve(String(reader.result).split(',')[1])
          reader.onerror = reject
          reader.readAsDataURL(file)
        })
        await gh(`/contents/public/${name}`, {
          method: 'PUT',
          body: JSON.stringify({ message: '上传图片', content: base64, branch: BRANCH }),
        })
        const markdown = `![${file.name || '图片'}](/${name})`
        wrap(markdown, '', '')
        setStatus($('post-status'), '图片已上传，发布后生效', 'ok')
      } catch (e) {
        setStatus($('post-status'), '图片上传失败：' + e.message, 'err')
      }
    }

    body.addEventListener('dragover', e => { e.preventDefault() })
    body.addEventListener('drop', e => {
      const file = e.dataTransfer?.files?.[0]
      if (file && file.type.startsWith('image/')) { e.preventDefault(); uploadImage(file) }
    })
    body.addEventListener('paste', e => {
      const item = [...(e.clipboardData?.items || [])].find(i => i.type.startsWith('image/'))
      if (item) { e.preventDefault(); uploadImage(item.getAsFile()) }
    })

    // 预览
    marked.setOptions({ breaks: true, gfm: true })
    $('tab-edit').addEventListener('click', () => {
      preview.classList.remove('on')
      body.style.display = ''
      $('tab-edit').classList.add('on')
      $('tab-preview').classList.remove('on')
    })
    $('tab-preview').addEventListener('click', () => {
      preview.innerHTML = marked.parse(body.value || '*还没有内容*')
      preview.classList.add('on')
      body.style.display = 'none'
      $('tab-preview').classList.add('on')
      $('tab-edit').classList.remove('on')
    })

    function updateCount() {
      const n = body.value.replace(/\s/g, '').length
      $('wordcount').textContent = n ? n + ' 字' : ''
    }
    body.addEventListener('input', updateCount)

    // Tab 缩进
    body.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault()
        body.setRangeText('  ', body.selectionStart, body.selectionEnd, 'end')
        updateCount()
      }
    })

    // 草稿
    const saveDraft = () => {
      localStorage.setItem('post_draft', JSON.stringify({
        title: $('post-title').value,
        slug: $('post-slug').value,
        tags: $('post-tags').value,
        desc: $('post-desc').value,
        body: body.value,
      }))
    }
    $('save-draft').addEventListener('click', () => {
      saveDraft()
      setStatus($('post-status'), '已存到本机浏览器（换设备看不到）', 'ok')
    })

    ;(() => {
      try {
        const draft = JSON.parse(localStorage.getItem('post_draft') || 'null')
        if (!draft) return
        $('post-title').value = draft.title || ''
        $('post-slug').value = draft.slug || ''
        $('post-tags').value = draft.tags || ''
        $('post-desc').value = draft.desc || ''
        body.value = draft.body || ''
        updateCount()
      } catch {}
    })()

    // 发布
    const slugify = raw => raw
      .trim()
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/[\\/:*?"<>|#%{}$!'@+`=~^&;]/g, '')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '')

    $('publish').addEventListener('click', async () => {
      const btn = $('publish')
      const title = $('post-title').value.trim()
      if (!title) { setStatus($('post-status'), '先写标题', 'err'); $('post-title').focus(); return }
      const markdown = body.value.trim()
      if (!markdown) { setStatus($('post-status'), '正文还是空的', 'err'); return }

      const slug = editing ? editing.slug : (slugify($('post-slug').value) || slugify(title) || `post-${Date.now()}`)
      const tags = $('post-tags').value.split(/[,，]/).map(s => s.trim()).filter(Boolean)
      const desc = $('post-desc').value.trim()
      const today = new Date().toISOString().slice(0, 10)

      const front = [
        '---',
        `title: ${title}`,
        `published: ${today}`,
        desc ? `description: ${desc}` : null,
        tags.length ? `tags: [${tags.join(', ')}]` : null,
        '---',
        '',
      ].filter(Boolean).join('\n')

      btn.disabled = true
      setStatus($('post-status'), '提交中…')
      try {
        const path = `src/content/posts/${slug}.md`
        let sha = editing ? editing.sha : null
        if (!editing) {
          const existing = await getFile(path)
          if (existing) throw new Error(`网址 ${slug} 已存在，换一个`)
        }
        await putFile(path, front + markdown + '\n', editing ? `更新文章：${title}` : `新文章：${title}`, sha)
        localStorage.removeItem('post_draft')
        if (editing) {
          setStatus($('post-status'), '已保存。构建约 1–2 分钟。', 'ok')
        } else {
          setStatus($('post-status'), `已提交：${slug}。构建约 1–2 分钟。`, 'ok')
          $('post-title').value = ''
          $('post-slug').value = ''
          $('post-tags').value = ''
          $('post-desc').value = ''
          body.value = ''
          updateCount()
        }
      } catch (e) {
        setStatus($('post-status'), '发布失败：' + e.message, 'err')
      } finally {
        btn.disabled = false
      }
    })

    // ===== 编辑模式 =====
    let editing = null

    async function deletePost(slug) {
      if (!confirm('确定删除这篇？')) return
      try {
        const file = await getFile(`src/content/posts/${slug}.md`)
        if (!file) return
        await gh(`/contents/src/content/posts/${slug}.md`, {
          method: 'DELETE',
          body: JSON.stringify({ message: '删除文章：' + slug, sha: file.sha, branch: BRANCH }),
        })
        location.href = '/'
      } catch (e) {
        alert('删除失败：' + e.message)
      }
    }

    async function loadForEdit() {
      const slug = new URLSearchParams(location.search).get('edit')
      if (!slug) return
      $('edit-banner').style.display = ''
      $('edit-status').textContent = '正在载入…'
      if (!token()) {
        $('edit-status').textContent = '先保存令牌，然后刷新本页'
        return
      }
      try {
        const file = await getFile(`src/content/posts/${slug}.md`)
        if (!file) { $('edit-status').textContent = '没有找到这篇文章'; return }
        const m = file.text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/)
        const front = m ? m[1] : ''
        const rest = m ? m[2] : file.text
        const pick = (key) => {
          const line = front.split(/\r?\n/).find(l => l.startsWith(key + ':'))
          return line ? line.slice(key.length + 1).trim().replace(/^["']|["']$/g, '') : ''
        }
        $('post-title').value = pick('title')
        $('post-desc').value = pick('description')
        $('post-tags').value = pick('tags').replace(/^\[|\]$/g, '').split(',').map(s => s.trim()).filter(Boolean).join(', ')
        body.value = rest.trim()
        updateCount()
        const slugInput = $('post-slug')
        slugInput.value = slug
        slugInput.readOnly = true
        slugInput.style.background = '#f3f2ef'
        editing = { slug, sha: file.sha }
        $('publish').textContent = '保存修改'
        $('edit-status').textContent = '正在编辑：' + slug
        $('view-post').href = '/posts/' + encodeURIComponent(slug) + '/'
        $('delete-post').addEventListener('click', () => deletePost(slug))
      } catch (e) {
        $('edit-status').textContent = '载入失败：' + e.message
      }
    }

    loadForEdit()
  </script>
</body>
</html>
