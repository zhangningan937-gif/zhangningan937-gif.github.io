/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1.25rem
  --content-delay 150ms

/* Aurora gradient colors behind the frosted panels */
:root
  --aurora-1: rgba(77, 124, 255, 0.45)
  --aurora-2: rgba(122, 90, 255, 0.30)
  --aurora-3: rgba(0, 47, 167, 0.26)
  --aurora-a: #E8F0FF
  --aurora-b: #BCD2FF
  --aurora-c: #8FB0FF

:root.dark
  --aurora-1: rgba(0, 47, 167, 0.55)
  --aurora-2: rgba(99, 91, 255, 0.32)
  --aurora-3: rgba(0, 27, 94, 0.55)
  --aurora-a: #071230
  --aurora-b: #0B1E56
  --aurora-c: #050D22

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: #002FA7 #8FAAFF
  --page-bg: #EDF1FB #060A18
  --card-bg: rgba(255, 255, 255, 0.66) rgba(16, 24, 46, 0.52)

  --btn-content: #002FA7 #A9C0FF

  --btn-regular-bg: rgba(255, 255, 255, 0.55) rgba(255, 255, 255, 0.08)
  --btn-regular-bg-hover: rgba(255, 255, 255, 0.8) rgba(255, 255, 255, 0.15)
  --btn-regular-bg-active: rgba(226, 233, 249, 0.9) rgba(255, 255, 255, 0.22)

  --btn-plain-bg-hover: rgba(255, 255, 255, 0.55) rgba(255, 255, 255, 0.09)
  --btn-plain-bg-active: rgba(255, 255, 255, 0.8) rgba(255, 255, 255, 0.15)

  --btn-card-bg-hover: rgba(255, 255, 255, 0.35) rgba(255, 255, 255, 0.07)
  --btn-card-bg-active: rgba(255, 255, 255, 0.55) rgba(255, 255, 255, 0.12)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #0B1020 #F3F6FF

  --title-active: #2549A8 #A9C0FF

  --line-divider: rgba(11, 16, 32, 0.10) rgba(255, 255, 255, 0.12)

  --line-color: rgba(255, 255, 255, 0.85) rgba(255, 255, 255, 0.16)
  --meta-divider: rgba(11, 16, 32, 0.18) rgba(255, 255, 255, 0.22)

  --inline-code-bg: rgba(0, 47, 167, 0.08) rgba(255, 255, 255, 0.08)
  --inline-code-color: #1B3A8F #A9C0FF
  --selection-bg: rgba(0, 47, 167, 0.20) rgba(127, 160, 255, 0.30)
  --codeblock-selection: rgba(255, 255, 255, 0.15) rgba(255, 255, 255, 0.15)
  --codeblock-bg: #071132 #070C18
  --codeblock-topbar-bg: #0C1A45 #0D1528

  --license-block-bg: rgba(11, 16, 32, 0.03) var(--codeblock-bg)

  --link-underline: #C9D6F5 #2A3F7A
  --link-hover: #A9BEEE #35508F
  --link-active: #8FA9E6 #2B4276

  --float-panel-bg: rgba(255, 255, 255, 0.86) rgba(14, 20, 40, 0.88)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: rgba(255, 255, 255, 0.75) var(--btn-regular-bg)
  --toc-btn-hover: rgba(255, 255, 255, 0.55) rgba(255, 255, 255, 0.10)
  --toc-btn-active: rgba(255, 255, 255, 0.8) rgba(255, 255, 255, 0.16)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #002FA7 #7FA0FF
})
